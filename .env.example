# Porta HTTP do serviço (padrão: 3000)
PORT=3000

# Ambiente de execução: development | production | test
NODE_ENV=development

# Segredo usado para assinar os tokens JWT.
# Obrigatório quando NODE_ENV=production.
JWT_SECRET=troque-este-segredo

# Validade do token de acesso, em segundos (padrão: 3600)
JWT_EXPIRACAO_SEGUNDOS=3600

# Conexão com o Postgres. Obrigatória quando NODE_ENV=production.
# Sem ela, a API usa persistência em memória (útil para desenvolvimento).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fiapx?schema=public"
