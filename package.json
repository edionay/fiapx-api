{
  "name": "fiapx-api",
  "version": "0.1.0",
  "description": "API do Sistema de Processamento de Vídeos FIAP X — autenticação, upload, status e download.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/server.js",
  "scripts": {
    "gerar": "prisma generate && tsoa spec-and-routes",
    "copiar-spec": "node -e \"const fs=require('node:fs');fs.mkdirSync('dist/gerado/tsoa',{recursive:true});fs.copyFileSync('src/gerado/tsoa/swagger.json','dist/gerado/tsoa/swagger.json')\"",
    "dev": "npm run gerar && tsx watch src/server.ts",
    "build": "npm run gerar && tsc && npm run copiar-spec",
    "start": "node dist/server.js",
    "typecheck": "npm run gerar && tsc --noEmit",
    "test": "npm run gerar && vitest run",
    "test:watch": "npm run gerar && vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "postinstall": "npm run gerar"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tsoa/runtime": "^6.6.0",
    "amqplib": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "tsoa": "^6.6.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
