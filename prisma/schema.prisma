generator client {
  provider     = "prisma-client"
  output       = "../src/gerado/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id        String   @id
  email     String   @unique
  senhaHash String   @map("senha_hash")
  criadoEm  DateTime @default(now()) @map("criado_em")

  @@map("usuarios")
}
